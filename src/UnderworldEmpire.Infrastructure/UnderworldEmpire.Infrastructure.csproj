<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\UnderworldEmpire.Domain\UnderworldEmpire.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- AccountEndpoints (Api) catches the same unique-violation shape the action services do,
         via WriteConflicts.IsUniqueViolation — there's no separate account action service for it
         to live behind, so the check itself needs to be visible across the assembly boundary. -->
    <InternalsVisibleTo Include="UnderworldEmpire.Api" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
