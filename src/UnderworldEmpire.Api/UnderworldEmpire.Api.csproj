<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- Pin Microsoft.OpenApi above 2.0.0 (pulled transitively by Swashbuckle) to clear
         NU1903 (GHSA-v5pm-xwqc-g5wc). -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.12.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\UnderworldEmpire.Domain\UnderworldEmpire.Domain.csproj" />
    <ProjectReference Include="..\UnderworldEmpire.Infrastructure\UnderworldEmpire.Infrastructure.csproj" />
  </ItemGroup>

  <!-- Copy content pack JSON files to build output so the loader can find them at runtime
       and in integration tests (AppContext.BaseDirectory/content/<packId>/pack.json). -->
  <ItemGroup>
    <Content Include="..\..\content\**\*.json"
             Link="content\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
