<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- Pin Microsoft.OpenApi above 2.0.0 (pulled transitively by Swashbuckle) to clear
         NU1903 (GHSA-v5pm-xwqc-g5wc). -->
    <PackageReference Include="Microsoft.OpenApi" Version="2.12.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\UnderworldEmpire.Domain\UnderworldEmpire.Domain.csproj" />
    <ProjectReference Include="..\UnderworldEmpire.Infrastructure\UnderworldEmpire.Infrastructure.csproj" />
  </ItemGroup>

  <!-- Copy content pack files to build output so the loader can find them at runtime and in
       integration tests (AppContext.BaseDirectory/content/<packId>/pack.json).

       Art assets (T4.1) are copied alongside the JSON: GET /content/assets/{key} streams them
       from the pack folder, so a pack whose manifest names a logo it cannot serve would render
       a broken image in the app. The extension list mirrors the allow-list in PackAssets. -->
  <ItemGroup>
    <Content Include="..\..\content\**\*.json;..\..\content\**\*.png;..\..\content\**\*.jpg;..\..\content\**\*.jpeg;..\..\content\**\*.webp;..\..\content\**\*.svg"
             Link="content\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
